{
  "name": "neochat-desktop",
  "version": "1.4.2",
  "description": "NeoChat Desktop AI Workspace & Chat",
  "main": "electron/main.js",
  "type": "commonjs",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "vite build",
    "build:electron": "electron-builder",
    "dist": "pnpm build && pnpm build:electron",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "release": "pnpm build && electron-builder --win --publish always",
    "release:create": "node scripts/release.js",
    "release:publish": "node scripts/publish-release.js",
    "release:all": "pnpm build && electron-builder --publish always",
    "test:platforms": "./test-cross-platform.sh",
    "test:paths": "node test-paths.js",
    "test:interface-mode": "node test-interface-mode.js",
    "test:secret-store": "node test-secret-store.js",
    "test:tool-permissions": "node test-tool-permissions.js",
    "test:chat-branching": "node test-chat-branching.js",
    "test:backup-manager": "node test-backup-manager.js",
    "test:workflows": "node test-workflows.js",
    "test:scheduler": "node test-scheduler.js",
    "test:rag-incremental": "node test-rag-incremental.js",
    "test:provider-fallback": "node test-provider-fallback.js",
    "test:tts-settings": "node test-tts-settings.js",
    "test:update-manager": "node test-update-manager.js",
    "test:observability": "node test-observability-manager.js",
    "test:git-manager": "node test-git-manager.js",
    "test:config-dir": "node test-config-dir.js",
    "test:canvas": "node test-canvas.js",
    "test:canvas-tts": "node test-canvas-tts.js",
    "test:latex": "node test-latex.js"
  },
  "keywords": [
    "electron",
    "groq",
    "desktop",
    "chat"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "ansi-to-html": "^0.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "electron-json-storage": "^4.6.0",
    "electron-updater": "^6.8.9",
    "groq-sdk": "0.16.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.523.0",
    "next-themes": "^0.4.6",
    "node-fetch": "^2.6.6",
    "officeparser": "^7.8.0",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.3.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-textarea-autosize": "^8.5.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.25.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "concurrently": "9.1.2",
    "cross-env": "^7.0.3",
    "electron": "37.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "postcss": "^8.4.31",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.3.3",
    "vite": "^6.2.6",
    "vitepress": "^1.6.4",
    "wait-on": "8.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
